@model RoleIndexViewModel
@{
    ViewData["Title"] = "Roles";
    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10" },
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40" },
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>Role</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/administration/role/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> Add New Role</a>
                    </div>
                    <form action="/administration/role" method="get" class="row col-sm-6">
                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Role Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>SN</th>
                                <th>Name</th>
                                <th>Permissions</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sn = 1;
                                foreach (var role in Model.role_details)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@role.name</td>
                                        <td>
                                            @{
                                                string permissions = string.Join(",", role.permissions);
                                            }
                                            @permissions
                                        </td>
                                        <td>
                                            @{
                                                if (role.is_active)
                                                {
                                                    <label class="badge badge-success input-sm">Enabled</label>
                                                }
                                                else
                                                {
                                                    <label class="badge badge-danger input-sm">Disabled</label>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-primary " href="javascript:void(0);" style="width:65px;">Actions</a>
                                                <a class="btn btn-primary  dropdown-toggle" data-toggle="dropdown" href="javascript:void(0);" aria-expanded="false"><i class=""></i></a>
                                                <ul class="dropdown-menu dropdown-primary">
                                                    <li>
                                                        <a class="dropdown-item" href="/administration/role/edit/@role.role_id"><i class="fa fa-edit fa-lg">  Edit</i></a>
                                                    </li>
                                                    <li>
                                                        @{
                                                            if (role.is_active)
                                                            {
                                                                <a class="dropdown-item" href="/administration/role/disable/@role.role_id"><i class="fa fa-thumbs-o-down fa-lg">  Disable</i></a>
                                                            }
                                                            else
                                                            {
                                                                <a class="dropdown-item" href="/administration/role/enable/@role.role_id"><i class="fa fa-thumbs-o-up fa-lg">  Enable</i></a>
                                                            }
                                                        }
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item delete" href="/administration/role/delete/@role.role_id"><i class="fa fa-trash fa-lg">  Delete</i></a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $('.delete').on('click', function () {
            if (!confirm("Are you sure to delete?")) {
                event.preventDefault();
            }
        });
    </script>
}
