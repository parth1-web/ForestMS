@model LE.Infrastructure.Dto.UpdatePasswordDto
@{
    ViewData["Title"] = "Change Password";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>Update Password</b></h4>
                <p class="text-muted m-b-30">
                    Updates password of a user.
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post" action="/administration/user/change-password">
                            @Html.ValidationSummary(true)
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(a => a.type_id)
                            @Html.HiddenFor(a => a.type)

                            <div class="form-group row">
                                @Html.LabelFor(a => a.old_password, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.PasswordFor(a => a.old_password, new { @class = "form-control pass" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.old_password)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.new_password, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.PasswordFor(a => a.new_password, new { @class = "form-control pass" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.new_password)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.confirm_password, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.PasswordFor(a => a.confirm_password, new { @class = "form-control pass" })
                                    <input type='checkbox' id='check' />
                                    <label for="check">Show password</label>
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.confirm_password)</p>
                            </div>

                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#check').click(function () {
                $(this).is(':checked') ? $('.pass').attr('type', 'text') : $('.pass').attr('type', 'password');
            });
        });
    </script>
}