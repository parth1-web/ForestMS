@model UserIndexViewModel
@{
    ViewData["Title"] = "Users";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>Users</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/administration/user/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> Add New User</a>
                    </div>
                    <form action="/administration/user" method="get" class="row col-sm-6">
                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "User Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>Full Name</th>
                                <th>Address 1</th>
                                <th>Address 2</th>
                                <th>Contact</th>
                                <th style="width:120px;">Email</th>
                                <th>Created Date</th>
                                <th>Username</th>
                                <th style="width:100px;">Roles</th>
                                <th style="width:80px;">Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                foreach (var user in Model.user_details)
                                {
                                    <tr>
                                        <td>@user.full_name</td>
                                        <td>@user.address_line_1</td>
                                        <td>@user.address_line_2</td>
                                        <td>@user.primary_contact,@user.secondary_contact</td>
                                        <td>@user.email</td>
                                        <td>@user.created_date.ToString("yyyy-MM-dd")</td>
                                        <td>@user.username</td>
                                        <td>
                                            @{
                                                string role = string.Join(",", user.roles);
                                            }
                                            @role
                                        </td>
                                        <td>
                                            <p>
                                                @{
                                                    var status = user.is_active ? "Enabled" : "Disabled";
                                                    <label class="badge badge-info input-sm">@status</label>
                                                }
                                            </p>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-primary " href="javascript:void(0);" style="width:65px;">Actions</a>
                                                <a class="btn btn-primary  dropdown-toggle" data-toggle="dropdown" href="javascript:void(0);" aria-expanded="false"><i class=""></i></a>
                                                <ul class="dropdown-menu dropdown-primary">
                                                    <li>
                                                        <a class="dropdown-item" href="/administration/user/edit/@user.user_id"><i class="fa fa-edit fa-lg">  Edit</i></a>
                                                    </li>
                                                    <li>
                                                        @{
                                                            if (user.is_active)
                                                            {
                                                                <a class="dropdown-item" href="/administration/user/disable/@user.user_id"><i class="fa fa-thumbs-o-down fa-lg">  Disable</i></a>
                                                            }
                                                            else
                                                            {
                                                                <a class="dropdown-item" href="/administration/user/enable/@user.user_id"><i class="fa fa-thumbs-o-up fa-lg">  Enable</i></a>
                                                            }
                                                        }
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" href="/administration/user/change-password/@user.authentication_id"><i class="fa fa-cog fa-lg">  Change Password</i></a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>
