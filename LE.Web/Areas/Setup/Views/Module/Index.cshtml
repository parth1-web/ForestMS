@model List<ModuleDto>
@{
    ViewData["Title"] = "Module";

    var list = new List<SelectListItem>() {
new SelectListItem { Text = "10", Value = "10"},
new SelectListItem { Text = "20", Value = "20" },
new SelectListItem { Text = "30", Value = "30" },
new SelectListItem { Text = "40", Value = "40"},
new SelectListItem { Text = "50", Value = "50" }
};
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>Modules</b></h4>
                <div class="row">
                    <div class="col-sm-6">
                        <a href="/setup/module/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> Add New Module</a>
                    </div>
                    <form action="/setup/module" method="get" class="row col-sm-6">

                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.module_name, new { @class = "form-control no-padding", placeholder = "Module Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>

                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>Module Id</th>
                                <th>Module Name</th>
                                <th>Module Code</th>
                                <th>Display Icon</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                foreach (var moduleDto in Model)
                                {
                                    <tr>

                                        <td>@sn</td>
                                        <td>@moduleDto.module_id</td>
                                        <td>@moduleDto.module_name</td>
                                        <td>@moduleDto.module_code</td>
                                        <td>@moduleDto.display_icon</td>
                                        <td>

                                            <a href="/setup/module/edit/@moduleDto.module_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm"><i class="fa fa-pencil"></i></a>

                                            <a href="/setup/module/delete/@moduleDto.module_id" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete"><i class="fa fa-trash"></i></a>

                                        </td>

                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>