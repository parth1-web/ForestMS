@model List<LE.Web.Areas.Setup.ViewModels.DynamicMenuViewModel>
@{
    ViewData["Title"] = "Module";

    var list = new List<SelectListItem>() {
new SelectListItem { Text = "10", Value = "10"},
new SelectListItem { Text = "20", Value = "20" },
new SelectListItem { Text = "30", Value = "30" },
new SelectListItem { Text = "40", Value = "40"},
new SelectListItem { Text = "50", Value = "50" }
};
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>Menus</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/setup/menu/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> Add New Menu</a>
                    </div>
                    <form action="/setup/menu" method="get" class="row col-sm-6">

                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.menu_name, new { @class = "form-control", placeholder = "Menu Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>

                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>Menu Name</th>
                                <th>Module Name</th>
                                <th>Parent Menu</th>
                                <th>Icon</th>
                                <th>Web Url</th>
                                <th>API Url</th>
                                <th>Display No.</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                foreach (var menuDto in Model)
                                {
                                    <tr>

                                        <td>@sn</td>
                                        <td>@menuDto.menu_name</td>
                                        <td>@menuDto.module_name</td>
                                        <td>@menuDto.parent_menu_name</td>
                                        <td>@menuDto.icon</td>
                                        <td>@menuDto.web_url</td>
                                        <td>@menuDto.api_url</td>
                                        <td>@menuDto.display_order</td>
                                        <td>

                                            <a href="/setup/menu/edit/@menuDto.dynamic_menu_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm"><i class="fa fa-pencil"></i></a>

                                            <a href="/setup/menu/delete/@menuDto.dynamic_menu_id" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete"><i class="fa fa-trash"></i></a>

                                        </td>

                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="setup_dynamicmenu_index"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>