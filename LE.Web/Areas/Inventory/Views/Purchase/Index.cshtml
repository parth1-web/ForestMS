@model PurchaseIndexViewModel;
@{
    ViewData["Title"] = "Add Firewood Stock";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Firewood Stock"]</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/inventory/daura/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add Stock"]</a>
                    </div>
                    <form action="/inventory/daura" method="get" class="row col-sm-6">
                        <div class="offset-sm-2 col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Item Name" })
                        </div>
                        <div class="col-sm-2">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="form-control btn btn-primary btn-sm"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Date"]</th>
                                <th>@Localizer["Item"]</th>
                                <th>@Localizer["Quantity"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sn = 1;
                                foreach (var item in Model.purchase_items)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@item.nep_purchase_date</td>
                                        <td>@item.stock_items.name</td>
                                        <td>@item.qty</td>
                                        <td>
                                            <a href="/inventory/daura/delete/@item.purchase_id" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete"><i class="fa fa-trash"></i></a>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>