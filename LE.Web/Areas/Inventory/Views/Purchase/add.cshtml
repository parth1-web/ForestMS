@model PurchaseModel
@{
    ViewData["Title"] = "Add Firewood Stock";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Add Stock"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Adds a Stock."]
                </p>
                <form class="form-horizontal" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-lg-6">
                            @Html.ValidationSummary(true)
                            @Html.AntiForgeryToken()

                            <div class=" form-group row">
                                @Html.LabelFor(a => a.stock_item_id, new { @class = "col-md-4 control-label asterik" })
                                <div class="col-md-8">
                                    @Html.DropDownList("stock_item_id", (SelectList)ViewBag.items, new { @class = "form-control" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.stock_item_id)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.qty, new { @class = "col-md-4 control-label " })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(a => a.qty, new { @class = "form-control " })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.qty)</p>
                            </div>

                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
    </script>
}