@model StockItemIndexViewModel;
@{
    ViewData["Title"] = "Firewood";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Firewood"]</b></h4>
                <div class="row">
                    <div class="col-sm-6">
                        <a href="/inventory/stock-item/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add New Firewood"]</a>
                    </div>
                    <form action="/inventory/stock-item" method="get" class="row col-sm-6">

                        <div class="offset-sm-2 col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Stock Item Name" })
                        </div>
                        <div class="col-sm-2">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="form-control btn btn-primary btn-sm"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <br />
                <div class="table-responsive">
                    <table class="table m-0 table-colored-bordered table-bordered-custom ">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Item Name"]</th>
                                <th>@Localizer["Wood Type"]</th>
                                <th>@Localizer["Stock Unit"]</th>
                                <th>@Localizer["Threshold"]</th>
                                <th>@Localizer["Sales Rate(default)"]</th>
                                <th>@Localizer["Available Stock"]</th>
                                <th>@Localizer["Enabled/Disabled"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                foreach (var item in Model.stock_items)
                                {
                                    string status = "Enabled";
                                    string statusColor = "success";
                                    if (item.is_enabled == false)
                                    {
                                        status = "Disabled";
                                        statusColor = "danger";
                                    }
                                    <tr>
                                        <td>@sn</td>
                                        <td>@item.name</td>
                                        <td>@item.wood_type.name</td>
                                        <td>@item.stock_unit.name</td>
                                        <td>@item.threshold</td>
                                        <td>@item.default_sales_rate</td>
                                        <td>@item.stock_item_availability?.qty</td>
                                        <td><span class="badge badge-@statusColor">@status</span></td>
                                        <td>
                                            <a href="/inventory/stock-item/edit/@item.stock_item_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
                                            <a href="/inventory/stock-item/delete/@item.stock_item_id" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete"><i class="fa fa-trash"></i></a>
                                            @{
                                                string actionName = item.is_enabled ? "disable" : "enable";
                                                string icon = item.is_enabled ? "fa-thumbs-down" : "fa-thumbs-up";
                                                string color = item.is_enabled ? "btn-danger" : "btn-success";
                                            }
                                            <a href="/inventory/stock-item/@actionName/@item.stock_item_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm @color" data-toggle="tooltip" title="@actionName Item"><i class="fa @icon"></i></a>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <br />
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>