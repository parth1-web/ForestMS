@model PilingIndexViewModel;
@{
    ViewData["Title"] = "Piling";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "All", Value = "" }
    };
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Piling"]</b></h4>
                <div class="row">
                    <div class="col-sm-6">
                        <a href="/inventory/piling/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add New Piling"]</a>
                    </div>
                    <form action="/inventory/piling" method="get" class="row col-sm-6">
                        <div class="offset-sm-2 col-sm-6">
                            @Html.TextBox("title", "", new { @class = "form-control", placeholder = "Piling Title" })
                        </div>
                        <div class="col-sm-2">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="form-control btn btn-primary btn-sm"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <br />
                <div class="table-responsive">
                    <table class="table m-0 table-colored-bordered table-bordered-custom">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Piling Title"]</th>
                                <th>@Localizer["Description"]</th>
                                <th>@Localizer["Is Enabled?"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sn = 1;
                                foreach (var piling in Model.pilings)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@piling.title</td>
                                        <td>@piling.description</td>
                                        <td>@piling.is_enabled</td>
                                        <td>
                                            <a href="/inventory/piling/edit/@piling.piling_id" title="Edit" class="btn btn-icon waves-effect waves-light btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
                                            <a href="/inventory/piling/delete/@piling.piling_id" title="Delete" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete"><i class="fa fa-trash"></i></a>
                                            @{
                                                string actionName = piling.is_enabled ? "disable" : "enable";
                                                string icon = piling.is_enabled ? "fa-thumbs-down" : "fa-thumbs-up";
                                                string color = piling.is_enabled ? "btn-danger" : "btn-success";
                                            }
                                            <a href="/inventory/piling/@actionName/@piling.piling_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm @color" data-toggle="tooltip" title="@actionName Item"><i class="fa @icon"></i></a>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <br />
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="inventory_piling_index"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>