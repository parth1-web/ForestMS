@model PilingDto
@{
    ViewData["Title"] = "Update Piling";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Update Piling"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Updates a Piling."]
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post" action="/inventory/piling/edit">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(a => a.piling_id)
                            @Html.AntiForgeryToken()

                            <div class="form-group row">
                                @Html.LabelFor(a => a.title, new { @class = "col-md-3 control-label asterik" })
                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.title, new { @class = "form-control name" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.title)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.description, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.TextAreaFor(a => a.description, new { @class = "form-control", @rows = "4" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.description)</p>
                            </div>

                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12">
                        <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
    </script>
}
