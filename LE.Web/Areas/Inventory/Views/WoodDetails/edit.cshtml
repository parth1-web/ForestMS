            $(".name").focus();
            $("#stock_type_id").change(function () {
                var type_id = $("#stock_type_id").val();
                if (type_id ==  @((int)LE.Inventory.Common.Enums.StockTypes.Lakadi)) {
                    $(".balla_balli_category").hide();
