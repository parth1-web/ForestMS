@model WoodDetailsIndexViewModel;
@{
    ViewData["Title"] = "Canceled Transfer To Chiran Report";

    var list = new List<SelectListItem>() {
new SelectListItem { Text = "All", Value = "0"},
new SelectListItem { Text = "10", Value = "10"},
new SelectListItem { Text = "20", Value = "20" },
new SelectListItem { Text = "30", Value = "30" },
new SelectListItem { Text = "40", Value = "40"},
new SelectListItem { Text = "50", Value = "50" }
};
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Wood Canceled Transfer To Chiran Report"]</b></h4>
                <div class="row">

                    <form action="/inventory/wood-details/transfer-to-chiran-report" method="get" class="row col-sm-12">
                        <div class="col-sm-4"></div>
                        <div class="col-sm-3">
                            @Html.TextBox("search_by_golia_number", (string)ViewBag.search_by_golia_number, new { @class = "form-control no-padding", placeholder = "Goliya No" })
                        </div>
                        <div class="col-sm-2">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-1">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>

                        <div class="">
                            <button type="submit" formtarget="_blank" formaction="/inventory/wood-details/wood-transfer-to-chiran-print" class="btn btn-success waves-effect w-md waves-light pull-right" style="margin-left:5px;"> <i class="fa fa-print "></i></button>
                        </div>

                    </form>

                </div>
                <br />
                <div class="table-responsive">
                    <table class="table m-0 table-colored-bordered table-bordered-custom ">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th rowspan="2">#</th>
                                <th rowspan="2">@Localizer["Year"]</th>
                                <th rowspan="2">@Localizer["Goliya No"]</th>
                                <th rowspan="2">@Localizer["Wood Type"]</th>
                                <th rowspan="2">@Localizer["Purpose"]</th>
                                <th rowspan="2">@Localizer["Stock Type"]</th>
                                <th colspan="2" class="text-center">@Localizer["Wood Size"]</th>

                                <th rowspan="2">@Localizer["Total Wood Size"]</th>
                                <th colspan="2" class="text-center">@Localizer["Hole Status"]</th>

                                <th rowspan="2">@Localizer["Total Size"]</th>
                                <th rowspan="2">@Localizer["Grade"]</th>
                              
                            </tr>
                            <tr>
                                <th>@Localizer["Circle(inch)"]</th>
                                <th>@Localizer["Length(Feet)"]</th>

                                <th>@Localizer["Hole Size"]</th>
                                <th rowspan="2">@Localizer["Hole Total"]</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                decimal totalWoodSize = 0;
                                foreach (var item in Model.wood_details)
                                {

                                    <tr>

                                        <td>@sn</td>
                                        <td>@item.year</td>
                                        <td>@item.goliya_number</td>
                                        <td>@item.wood_type.name</td>
                                        <td>@item.category_purpose.name</td>
                                        <td>@Enum.GetName(typeof(LE.Inventory.Common.Enums.StockTypes), item.stock_type_id)</td>
                                        <td>@item.circle_size</td>
                                        <td>@item.length</td>
                                        <td>@item.fresh_total_size</td>

                                        <td>
                                            @{
                                                foreach (var damage in item.DamagedWoodDetails)
                                                {
                                                    <span>@damage.damaged_first_size + @damage.damaged_second_size + @damage.damaged_third_size + @damage.damaged_fourth_size + @damage.damaged_fifth_size X @damage.damaged_feet_size</span><br />
                                                }
                                            }
                                        </td>
                                        <td>@item.getDamagedsize()</td>
                                        <td>@item.getNetTotal()</td>
                                        <td>@item.grade</td>
                                      


                                    </tr>
                                    sn++;
                                }
                                <tr>
                                    <td colspan="11" class="text-right"><b>Total</b></td>
                                    <td><b> @totalWoodSize </b></td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <br />
                    <LeadingEdgePager info="@ViewBag.pagerInfo"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>