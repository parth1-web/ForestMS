@model AccountingReportVm;
@{
    ViewData["Title"] = @Localizer["Day Book"];
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Day Book"]</b></h4>
                <div class="row mb-2">
                    <form method="get" class="col-md-12 form-inline">
                        @Html.TextBoxFor(a => a.ToDate, new { @class = "date-picker form-control nepali-calendar mr-3" })

                        <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right" style="margin-left:5px;">
                            @Localizer["Load"] <i class="fa fa-spinner "></i>
                        </button>

                        <div class="pull-right">
                            <button type="submit" formaction="/accounting/report/day-book-print" formtarget="_blank" class="btn btn-success" style="margin-left:5px;">
                                <i class="fa fa-print "></i>
                            </button>
                            <button type="submit" formaction="/accounting/report/day-book-pdf" class="btn btn-danger" formtarget="_blank" title="Pdf">
                                <i class="fa fa-file-pdf-o fa-lg "></i>
                            </button>
                        </div>
                    </form>
                </div>
                <div>
                    <div class="report-table">
                        @{
                            var model = new AccountingReportDecoratorVm { ReportType = AccountingReportType.DrCrWise, Report = Model.RightReport };
                        }
                        <partial name="Accounting/AccountingReportDecorator" model="model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>