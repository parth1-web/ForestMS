@model LE.Account.Infrastructure.Dto.ProfitAndLossDto

@{
    ViewData["Title"] = "Profit and Loss";
    Layout = null;
}

<link href="~/css/print.css" rel="stylesheet" />
<link href="~/css/bootstrap.min.css" rel="stylesheet" />

<center>
    <page>
        <center class="header"> @Model.organization_name <br />@Model.address <br /> @Localizer["Profit And Loss"] <br />@Localizer["For the year"] @Model.start_date.Split("-")[0].ConvertNumerals() / @Model.end_date.Split("-")[0].ConvertNumerals()</center>

        <table>
            <thead>
                <tr>
                    <th>@Localizer["Particulars"]</th>
                    <th>@Localizer["Debit"]</th>
                    <th>@Localizer["Credit"]</th>
                </tr>
            </thead>
            <tbody>
                @{
                    decimal drTotal = 0;
                    decimal crTotal = 0;


                    decimal netProfitLoss = Model.opening_balance;
                    decimal netLoss = 0;
                    decimal netProfit = 0;
                    var message = "";
                    if (Model.opening_balance < 0)
                    {
                        netProfit = Math.Abs(netProfitLoss);
                        message = "By gross Profit b/d";
                        crTotal += netProfit;

                    }
                    else
                    {
                        netLoss = Math.Abs(netProfitLoss);
                        message = "To gross Loss b/d";
                        drTotal += netLoss;
                    }
                    if (netProfit > 0 || netLoss > 0)
                    {
                        <tr>
                            <td align="right">@Localizer[message]</td>
                            <td>@netLoss.ToString().ConvertNumerals()</td>
                            <td>@netProfit.ToString().ConvertNumerals()</td>
                        </tr>
                    }

                    foreach (var IncomeLedger in Model.getIncomeLedgerDtosWithAmount())
                    {

                        <tr>
                            <td>@IncomeLedger.ledger.name</td>
                            <td></td>
                            <td>@Math.Abs(IncomeLedger.amount).ToString().ConvertNumerals()</td>
                        </tr>

                    }
                    foreach (var expensesLedger in Model.getExpensesLedgerDtosWithAmount())
                    {

                        <tr>
                            <td>@expensesLedger.ledger.name</td>
                            <td>@Math.Abs(expensesLedger.amount).ToString().ConvertNumerals()</td>
                            <td></td>
                        </tr>
                    }

                    drTotal += Math.Abs(Model.getTotalExpensesBalance());
                    crTotal += Math.Abs(Model.getTotalIncomeBalance());
                    var finalMessage = "By Net Loss c/d";
                    decimal profitAmt = 0;
                    decimal lossAmt = 0;
                    if (crTotal > drTotal)
                    {
                        finalMessage = "To Net Profit c/d";
                        profitAmt = crTotal - drTotal;
                        drTotal += profitAmt;
                    }
                    else
                    {
                        lossAmt = drTotal - crTotal;
                        crTotal += lossAmt;
                    }

                    <tr>
                        <td>@Localizer[finalMessage]</td>
                        <td>@profitAmt.ToString().ConvertNumerals()</td>
                        <td>@lossAmt.ToString().ConvertNumerals()</td>
                    </tr>


                    <tr>
                        <td align="right"><b>@Localizer["Total"]</b></td>
                        <td class="font-600"><b>@drTotal.ToString().ConvertNumerals()</b></td>
                        <td class="font-600"><b>@crTotal.ToString().ConvertNumerals()</b></td>
                    </tr>
                }

            </tbody>
        </table>
    </page>
</center>
<script src="~/js/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        // window.print();

    });
</script>