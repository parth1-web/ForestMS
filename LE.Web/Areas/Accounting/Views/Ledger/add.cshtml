@model LedgerModel
@{
    ViewData["Title"] = "New Ledger";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["New Ledger"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Create a Ledger."]
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post">
                            @Html.ValidationSummary(true)

                            @Html.AntiForgeryToken()
                            <div class="form-group row">
                                @Html.LabelFor(a => a.name, new { @class = "col-md-3 control-label asterik" })

                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.name, new { @class = "form-control name" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.name)</p>
                            </div>
                            <div class="form-group row">
                                @Html.LabelFor(a => a.code, new { @class = "col-md-3 control-label " })

                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.code ,new { @class = "form-control" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.code)</p>
                            </div>

                            <div class=" form-group row">
                                @Html.LabelFor(a => a.ledger_group_id, new { @class = "col-md-3 control-label asterik" })
                                <div class="col-md-9">
                                    @Html.DropDownList("ledger_group_id", (SelectList)ViewBag.ledgers, new { @class = "form-control chosen" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.ledger_group_id)</p>

                            </div>

                            @* <div class="form-group row">
                                @Html.LabelFor(a => a.opening_balance, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.opening_balance, new { @class = "form-control" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.opening_balance)</p>
                            </div> *@


                            <div class="form-group row">
                                @Html.LabelFor(a => a.balance_type, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.DropDownList("balance_type", Html.GetEnumSelectList<LE.Account.Common.Enums.OpeningBalanceType>(), new { @class = "form-control" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.balance_type)</p>
                            </div>




                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12">
                        <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>

</div>
                </div>
                <!-- end row -->
            </div>
        </div>
    </div><!-- end col -->
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
    </script>
}
