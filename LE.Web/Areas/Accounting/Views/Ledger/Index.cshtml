@model LedgerIndexViewModel;
@{
    ViewData["Title"] = "Ledger";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Ledger"]</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/accounting/ledgers/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add New Ledger"]</a>
                    </div>
                    <form action="/accounting/ledgers" method="get" class="row col-sm-6">
                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Ledger Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Ledger Name"]</th>
                                <th>@Localizer["Created Date"]</th>
                                <th>@Localizer["Group"]</th>
                                <th>@Localizer["Group Type"]</th>
                                <th>@Localizer["Balance"]</th>
                                <th width="150">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sn = 1;
                                foreach (var ledger in Model.ledger_details)
                                {
                                    var prefix = "";
                                    if (ledger.balance < 0)
                                    {
                                        prefix = "(Cr)";
                                    }
                                    if (ledger.balance > 0)
                                    {
                                        prefix = "(Dr)";
                                    }

                                    <tr>
                                        <td>@sn</td>
                                        <td>@ledger.name (@ledger.code)</td>
                                        <td>@ledger.nep_created_date</td>
                                        <td>@(ledger.ledger_group?.name ?? "N/A")</td>
                                        <td>@(ledger.ledger_group?.ledger_group_type != null ? ledger.ledger_group.ledger_group_type.ToString() : "N/A")</td>
                                        <td>@Math.Abs(ledger.balance) @prefix</td>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-primary " href="javascript:void(0);" style="width:65px;">Actions</a>
                                                <a class="btn btn-primary  dropdown-toggle" data-toggle="dropdown" href="javascript:void(0);" aria-expanded="false"><i class=""></i></a>
                                                <ul class="dropdown-menu dropdown-primary">
                                                    <li>
                                                        <a class="dropdown-item" href="/accounting/ledgers/edit/@ledger.ledger_id"><i class="fa fa-edit fa-lg">  Edit</i></a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item delete" href="/accounting/ledgers/delete/@ledger.ledger_id"><i class="fa fa-trash fa-lg">  Delete</i></a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="accounting_ledger_index"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $("document").ready(function () {
            $('body').on('keydown', function (e) {
                var n = false;
                if (e.key === "n" || e.key === "N") {
                    n = true;
                }

                if (e.altKey && n === true) {
                    window.location.href = '/accounting/ledgers/new';
                }
            });
        });
    </script>
}