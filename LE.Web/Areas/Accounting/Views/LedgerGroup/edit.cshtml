@using LE.Web.Areas.Accounting.Models
@model LedgerGroupModel;
@{
    ViewData["Title"] = "Update Account Group";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title">
                    <b>
                        @Localizer["Update Account Group"]
                    </b>
                </h4>
                <p class="text-muted m-b-30">
                    @Localizer["Update a Account Group."]
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post" action="/accounting/groups/edit">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(a => a.ledger_group_id)
                            @Html.HiddenFor(a => a.code)

                            @{
                                if (Model.is_custom != true)
                                {
                                    @Html.HiddenFor(a => a.ledger_group_type)
                                    @Html.HiddenFor(a => a.parent_ledger_group_id)
                                }
                            }

                            @Html.AntiForgeryToken()
                            <div class="form-group row">
                                @Html.LabelFor(a => a.name, new { @class = "col-md-4 control-label asterik" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(a => a.name, new { @class = "form-control" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.name)</p>
                            </div>
                            @{
                                if (Model.is_custom == true)
                                {
                                    <div class=" form-group row">
                                        @Html.LabelFor(a => a.parent_ledger_group_id, new { @class = "col-md-4 control-label asterik" })
                                        <div class="col-md-8">
                                            @Html.DropDownList("parent_ledger_group_id", (SelectList)ViewBag.ledgerGroups, "*Primary", new { @class = "form-control chosen" })
                                        </div>
                                        <p class="text-danger">@Html.ValidationMessageFor(a => a.parent_ledger_group_id)</p>
                                    </div>

                                    <div class=" form-group row group-type-row">
                                        @Html.LabelFor(a => a.ledger_group_type, new { @class = "col-md-4 control-label asterik" })
                                        <div class="col-md-8">
                                            @Html.DropDownList("ledger_group_type", new SelectList(Enum.GetValues(typeof(LE.Account.Common.Enums.LedgerGroupType))), "--Select Type--", new { @class = "form-control" })
                                        </div>
                                        <p class="text-danger">@Html.ValidationMessageFor(a => a.ledger_group_type)</p>
                                    </div>
                                }
                            }

                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Update"]</i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12">
                        <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".chosen").select2();
            $("#name").focus();
            $("#parent_ledger_group_id").change(function () {
                var ledgerId = $("#parent_ledger_group_id").val();

                if (ledgerId > 0) {
                    $(".group-type-row").hide();
                    $("#ledger_group_type").val(0);
                }
                else {
                    $(".group-type-row").show();
                }
            });
            $("#parent_ledger_group_id").change();
        });
    </script>
}