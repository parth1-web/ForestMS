@using LE.Account.Common.Enums
@using LE.Web.Areas.Accounting.ViewModels
@model LedgerGroupIndexViewModel;
@{
    ViewData["Title"] = "Account Groups";

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Group"]</b></h4>
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <a href="/accounting/groups/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add New Group"]</a>
                    </div>
                    <form action="/accounting/groups" method="get" class="row col-sm-6">

                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Account Group Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>

                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Group Name"]</th>
                                <th>@Localizer["Under Group"]</th>
                                <th>@Localizer["Group Type"]</th>
                                <th>@Localizer["No of Ledgers"]</th>
                                <th>@Localizer["Is Custom?"]</th>
                                <th>@Localizer["Action"]</th>
                            </tr>
                        </thead>
                        <tbody>

                            @{ var sn = 1;
                                foreach (var ledgerGroup in Model.ledger_group_details)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@ledgerGroup.name</td>
                                        <td>@ledgerGroup.parent_group_name</td>
                                        <td>@Enum.GetName(typeof(LedgerGroupType), ledgerGroup.ledger_group_type)</td>
                                        <td>@ledgerGroup.getLedgersCount()</td>
                                        <td ><label class="badge badge-primary">@ledgerGroup.is_custom</label></td>
                                        <td>
                                            <div class="btn-group">
                                                <a class="btn btn-primary " href="javascript:void(0);" style="width:65px;">Actions</a>
                                                <a class="btn btn-primary  dropdown-toggle" data-toggle="dropdown" href="javascript:void(0);" aria-expanded="false"><i class=""></i></a>
                                                <ul class="dropdown-menu dropdown-primary">
                                                    <li>
                                                        <a class="dropdown-item" href="/accounting/groups/edit/@ledgerGroup.ledger_group_id"><i class="fa fa-edit fa-lg">  Edit</i></a>
                                                    </li>
                                                    @{
                                                        if (ledgerGroup.is_custom == true)
                                                        {
                                                            <li>
                                                                <a class="dropdown-item delete" href="/accounting/groups/delete/@ledgerGroup.ledger_group_id"><i class="fa fa-trash fa-lg">  Delete</i></a>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="accounting_ledgergroup_index"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/custom.js"></script>
