@using LE.Web.Areas.Accounting.Models
@model PaymentModel
@{
    ViewData["Title"] = "New Payment";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["New Payment"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Makes a Payment."]
                </p>
                <form class="form-horizontal" method="post">
                    <div class="row">
                        <div class="col-lg-6">
                            @Html.ValidationSummary(true)
                            @Html.AntiForgeryToken()

                            <div class="form-group row">
                                @Html.LabelFor(a => a.transaction_date, new { @class = "col-md-3 control-label asterik" })
                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.transaction_date, new { @class = "form-control tran-date nepali-calendar" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.transaction_date)</p>
                            </div>

                            <div class=" form-group row">
                                @Html.LabelFor(a => a.payment_to, new { @class = "col-md-3 control-label asterik" })
                                <div class="col-md-9">
                                    @Html.DropDownList("payment_to", (SelectList)ViewBag.paymentToLedgers, "--Select Ledger--", new { @class = "form-control payment-to chosen", required = "required" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.payment_to)</p>
                            </div>

                            <div class=" form-group row">
                                @Html.LabelFor(a => a.payment_from, new { @class = "col-md-3 control-label asterik payment-from" })
                                <div class="col-md-9">
                                    @Html.DropDownList("payment_from", (SelectList)ViewBag.paymentFromLedgers, "--Select Ledger--", new { @class = "form-control chosen", required = "required" })
                                    <i class="payment-from-amount text-purple font-600"></i>
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.payment_from)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.cheque_no, new { @class = "col-md-3 control-label" })
                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.cheque_no, new { @class = "form-control cheque_no" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.cheque_no)</p>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group row">
                                @Html.LabelFor(a => a.amount, new { @class = "col-md-3 control-label asterik" })

                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.amount, new { @class = "form-control", type = "number", step = ".01" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.amount)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.remarks, new { @class = "col-md-3 control-label asterik" })
                                <div class="col-md-9">
                                    @Html.TextAreaFor(a => a.remarks, new { @class = "form-control", required = "required" })
                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.remarks)</p>
                            </div>

                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right btn-save"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
            $('.chosen').select2();
            $(".cheque_date_row").hide();
            $('.cheque_no').keydown(function () {
                $(".cheque_date_row").show();
            });

            function getLedgerBalance($paymentFromId) {
                var result = 0;
                if ($paymentFromId > 0) {
                    $.ajax({
                        contentType: 'application/json; charset=utf-8',
                        type: "Get",
                        url: "/accounting/ledgers/get-ledger-end-balance/" + $paymentFromId,
                        dataType: "json",
                        async: false,
                        success: function (response) {
                            if (response == null) {
                                alert("Failed to get ledger end balance!");
                            }
                            else if (response.error == true) {
                                alert(response.responseText);
                            }
                            else {
                                result = response;
                            }
                        },
                        error: function (response) {
                            alert(response.responseText);
                        }
                    });
                }
                return result;
            }

            $("#payment_from").change(function () {
                var paymentFromId = parseInt($("#payment_from").val());
                $(".payment-from-amount").text("Rs: " + getLedgerBalance(paymentFromId));
            });

            $(".btn-save").click(function () {
                var paymentFromId = parseInt($("#payment_from").val());
                var amount = parseFloat($("#amount").val());
                var fromLedgerBalance = getLedgerBalance(paymentFromId);

                if (amount > fromLedgerBalance) {
                    alert("Insufficient Balance in Ledger.");
                    return false;
                }
            });
        });
    </script>
}