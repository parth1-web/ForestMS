@using LE.Common.Enums
@model MemberPunishmentDto
@{
    ViewData["Title"] = Localizer["Add Member Punishment"];
}
<style>
    .form-group {
        margin-bottom: 0;
    }

    .form-horizontal .form-group {
        margin-left: 0;
        margin-right: 0;
    }

    .form-control {
        border: 1px solid #c7c7c7;
        border-radius: 4px;
        padding: 6px 12px;
        height: 36px;
    }

    h4.title {
        background: #41b5e3;
        color: white;
        width: fit-content;
        padding: 4px 15px;
    }

    @@media (min-width: 768px) {
        .offset-md-6 {
            margin-left: 50% !important;
        }
    }
</style>
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="m-t-0 header-title"><b>@Localizer["New Member Punishment"]</b></h4>
                        <p class="text-muted">@Localizer["Creates a Member Punishment"].</p>
                    </div>
                </div>

                <div>
                    <form class="form-horizontal" method="post" enctype="multipart/form-data">
                        @Html.ValidationSummary(true)
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="form-group col-md-3">
                                @Html.LabelFor(a => a.MembershipId, new { @class = "control-label asterik" })
                                 @Html.DropDownListFor(a=>a.MembershipId, (SelectList)ViewBag.members, "-- Select membership --", new { @class = "form-control", @required = true })
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.MembershipId)</p>
                            </div>
                            <div class="form-group col-md-3">
                                @Html.LabelFor(a => a.IllegalActivity, new { @class = "control-label asterik" })
                                @Html.TextBoxFor(a => a.IllegalActivity, new { @class = "form-control", @required = true, @autoComplete = "off", @list = "activityList" })
                                <datalist id="activityList">
                                    <option value="दुरुपयोग, वन पैदावार" />
                                    <option value="चोरी" />
                                    <option value="आर्थिक हिनामिना" />
                                    <option value="अन्य" />
                                </datalist>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.IllegalActivity)</p>
                            </div>
                            <div class="form-group col-md-3">
                                @Html.LabelFor(a => a.NepPunishmentValidity, new { @class = "control-label asterik" })
                                @Html.TextBoxFor(a => a.NepPunishmentValidity, new { @class = "nepali-calendar form-control", @required = true, @readonly = true })
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.NepPunishmentValidity)</p>
                            </div>
                            <div class="form-group col-md-3" style="margin-top:11px;">
                                @Html.LabelFor(a => a.Remarks, new { @class = "control-label" })
                                @Html.TextBoxFor(a => a.Remarks, new { @class = "form-control" })
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.Remarks)</p>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="form-group">
                                <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
             
    </script>
}
