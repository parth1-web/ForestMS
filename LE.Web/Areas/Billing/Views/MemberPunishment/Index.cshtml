@model MemberPunishmentViewModel;
@{
    ViewData["Title"] = Localizer["Member Punishment"];

    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "10", Value = "10"},
        new SelectListItem { Text = "20", Value = "20" },
        new SelectListItem { Text = "30", Value = "30" },
        new SelectListItem { Text = "40", Value = "40"},
        new SelectListItem { Text = "50", Value = "50" }
    };
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Member Punishment"]</b></h4>
                <div class="row">
                    <div class="col-sm-6">
                        <a href="/billing/member-punishment/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add Member Punishment"]</a>
                    </div>
                    <form action="/billing/member-punishment" method="get" class="row col-sm-6">
                        <div class="col-sm-6">
                            @Html.TextBox("name", " ", new { @class = "form-control", placeholder = "Member Name or Code" })

                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>
                    </form>
                </div>
                <br />
                <div class="table-responsive">
                    <table class="table m-0 table-colored-bordered table-bordered-custom">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>@Localizer["S.N"]</th>
                                <th>@Localizer["Member Name"]</th>
                                <th>@Localizer["Membership Code"]</th>
                                <th>@Localizer["Illegal Activity"]</th>
                                <th>@Localizer["Punishment Validity"]</th>
                                <th>@Localizer["Contact No"]</th>
                                <th>@Localizer["Area"]</th>
                                <th>@Localizer["Tole No"]</th>
                                <th>@Localizer["Remarks"]</th>
                                <th>@Localizer["Actions"]</th>
                                @*                                 <th>@Localizer["Status"]</th>
 *@                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sn = 1;
                                foreach (var item in Model.MemPunishment)
                                {

                                    var badge = "";
                                    if (item.IsPunished)
                                    {
                                        badge = "badge badge-danger";
                                    }
                                    <tr>
                                        <td>@sn</td>
                                        <td>@(item.Membership != null && item.Membership.MemberDetails != null ? item.Membership.MemberDetails.Where(a=>a.IsGharmuli).FirstOrDefault()?.FullName ?? "N/A" : "N/A")</td>
                                        <td>@(item.Membership?.MembershipCode ?? "N/A")</td>
                                        <td>@item.IllegalActivity</td>
                                        <td><span class="@badge">@item.NepPunishmentValidity</span></td>
                                        <td>@(item.Membership != null && item.Membership.MemberDetails != null ? item.Membership.MemberDetails.Where(a => a.IsGharmuli).FirstOrDefault()?.ContactNo ?? "N/A" : "N/A")</td>
                                        <td>@(item.Membership?.Area ?? "N/A")</td>
                                        <td>@(item.Membership?.ToleNo ?? "N/A")</td>
                                        <td>@item.Remarks</td>
                                                
                                        <td>
                                            @if (item.PunishmentValidity.Date > DateTime.Now.Date)
                                            {
                                                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModal"
                                                        data-member-punishment-id="@item.MemberPunishmentId">
                                                    रद्द गर्नुहोस्
                                                </button>
                                            }
                                        </td>


                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <br />
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="billing_memberpunishment_index"></LeadingEdgePager>
                </div>



                <!-- Modal HTML -->
                <!-- Modal HTML -->
                <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">माफी</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true" style="background-color: red;">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="cancelPunishmentForm" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label for="IsCancelledRemarks" class="col-form-label">कैफियत:</label>
                                        <input type="text" class="form-control" id="IsCancelledRemarks" name="IsCancelledRemarks" required minlength="3">
                                        <small class="text-danger d-none" id="IsCancelledRemarksError">Please enter at least 3 characters.</small>
                                    </div>
                                    <input type="hidden" id="MemberPunishmentId" name="MemberPunishmentId" />
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-primary" id="savePunishmentBtn">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    $(document).ready(function () {
        $('#exampleModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); 
            var memberPunishmentId = button.data('member-punishment-id'); 
            $("#MemberPunishmentId").val(memberPunishmentId); 
            $("#IsCancelledRemarks").val("");
            $("#IsCancelledRemarksError").addClass("d-none");
        });

        $("#savePunishmentBtn").click(function () {
            let remarks = $("#IsCancelledRemarks").val().trim();

            if (remarks.length < 3) {
                $("#IsCancelledRemarksError").removeClass("d-none"); 
                return;
            } else {
                $("#IsCancelledRemarksError").addClass("d-none"); 
            }

            let data = {
                MemberPunishmentId: $("#MemberPunishmentId").val(),
                IsCancelledRemarks: remarks
            };

            $.ajax({
                url: "/billing/member-punishment/cancelled",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN",
                        $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                success: function (response) {
                    if (response && response.success) {
                        alert("Punishment updated successfully!");
                        $('#exampleModal').modal('hide');
                        location.reload();
                    } else {
                        alert("Error: " + ((response && (response.message || response.responseText)) || "Request failed. Please try again."));
                    }
                },
                error: function (xhr) {
                    var message = (xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.responseText)) || xhr.responseText || "Request failed. Please try again.";
                    alert("Error: " + message);
                }
            });
        });
    });
</script>
}