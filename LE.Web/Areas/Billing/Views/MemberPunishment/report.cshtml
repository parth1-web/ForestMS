@using LE.Billing.Common.Enums
@model MemberPunishmentReportIndexViewModel;
@{
	ViewData["Title"] = Localizer["Member Punishment Report"];
}
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-body">
				<h4 class="m-t-0 header-title"><b>@Localizer["Member Punishment Report"]</b></h4>
				<div class="row">
					<form method="get" class="col-md-11 form-inline mb-2">
						@Html.LabelFor(a => a.start_date, new { @class = "control-label", style = "margin-right:10px;" })
						@Html.TextBoxFor(a => a.start_date, new { @class = "form-control nepali-calendar" })

						@Html.LabelFor(a => a.end_date, new { @class = "control-label", style = "margin-right:10px; margin-left:15px;" })
						@Html.TextBoxFor(a => a.end_date, new { @class = "form-control nepali-calendar" })

						@Html.DropDownListFor(a => a.status, 
							new SelectList(Enum.GetValues(typeof(PunishmentStatus)).Cast<PunishmentStatus>()
							.Select(e => new { Value = (int)e, Text = e.ToString() }),"Value", "Text"), 
							new { @class = "form-control", style = "margin-right:10px; margin-left:15px;" })

						<button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right" style="margin-left:5px;">@Localizer["Load"] <i class="fa fa-spinner "></i></button>

						<div class="pull-right">
							<button type="submit" formtarget="_blank" formaction="/billing/member-punishment/report-print" class="btn btn-success waves-effect w-md waves-light pull-right" style="margin-left:5px;"> <i class="fa fa-print "></i></button>
						</div>
					</form>
				</div>
				<div class="table-responsive">
					<table class="table m-0">
						<thead class="bg-custom text-white">
							<tr>
								<th>@Localizer["S.N"]</th>
								<th>@Localizer["MemberName"]</th>
								<th>@Localizer["MemberShipCode"]</th>
								<th>@Localizer["IllegalActivity"]</th>
								<th>@Localizer["IssueDate"]</th>
								<th>@Localizer["PunishmentValidity"]</th>
								<th>@Localizer["Remarks"]</th>
								<th>@Localizer["Status"]</th>
								<th>@Localizer["Action"]</th>
							</tr>
						</thead>
						<tbody>
							@{
								var sn = 1;
								
								foreach (var detail in Model.member_punishment_report)
								{
									
									<tr>
										<td>@sn</td>
										<td>@detail.Membership.MemberDetails.Where(a=>a.IsGharmuli).FirstOrDefault().FullName</td>
										<td>@detail.Membership.MembershipCode</td>
										<td>@detail.IllegalActivity</td>
										<td>@detail.NepIssueDate</td>
										<td>@detail.NepPunishmentValidity</td>
										<td>@detail.Remarks</td>
										<td>
											@if (@detail.IsCancelled)
											{
												<span class="badge badge-danger">Cancelled</span>
											}
											else if (@detail.PunishmentValidity < DateTime.Now)
											{
												<span class="badge badge-secondary">Completed</span>
											}
											else
											{
												<span class="badge badge-success">Active</span>
											}
										</td>
										<td>
											<a href="/billing/member-punishment/SingleReport?MemberPunishmentId=@detail.MemberPunishmentId" target="_blank" class="btn btn-primary"><i class="fa fa-print"></i></a>
										</td>
									</tr>
									sn++;
								}
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>