@model ChiranBillModel

@{
    ViewData["Title"] = "चिरान बिल";
}

<div id="loading">
    <img id="loading-image" src="~/images/loader.gif" alt="Loading..." />
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>चिरान बिल</b></h4>
                <p class="text-muted m-b-30"></p>
                <div class="row" style="margin-top:-25px">
                    <form method="post" class="w-100">
                        <div class="col-lg-12">
                            @Html.ValidationSummary(true)
                            @Html.AntiForgeryToken()
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            मिति
                                        </div>
                                        <div class="col-md-8">
                                            @Html.TextBoxFor(a => a.nep_sales_date, new { @class = "input-sm form-control nepali-calendar ", @id = "nep_sales_date" })
                                        </div>
                                    </div>

                                    <div class="form-group row" style="margin-top:-10px">
                                        <div class="col-md-4">
                                            बिक्री किसिम
                                        </div>
                                        <div class="col-md-8">
                                            @Html.DropDownList("sales_type", Html.GetEnumSelectList<LE.Billing.Common.Enums.SalesType>(), new { @class = "form-control input-sm sales_type", @name = "sales_type", @id = "sales_type" })
                                        </div>
                                    </div>

                                    <div class="form-group row member-row" style="margin-top:-10px">
                                        <div class="col-md-4">
                                            सदस्य
                                        </div>
                                        <div class="col-md-8">
                                            @Html.DropDownList("MemberId", (SelectList)ViewBag.members, "--Select Member--", new
                                                {
                                                    @class = "form-control js-example-basic-multiple member",
                                                    id = "memberSelect"
                                                })
                                            <div id="membershipStatusMessage"></div>
                                        </div>
                                    </div>

                                    <div class="form-group row customer-row" style="margin-top:-10px">
                                        <div class="col-md-4">
                                            ग्राहक
                                        </div>
                                        <div class="col-md-8">
                                            <input type="text" class="form-control input-sm" name="other_customer" id="other_customer" />
                                        </div>
                                    </div>

                                    <div>
                                        <em style="color: #ba6262;font-size: 13px;"><span class="asterik"></span>@Localizer["Note"]: @Localizer["In case of member not found. Make sure member is active and membership not expired."]</em>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <table class="table table-striped item-container" id="invoice_item_table">
                                        <thead>
                                            <tr style="line-height:15px">
                                                <th width="30">क्र.सं</th>
                                                <th width="150">काठको जात</th>
                                                <th width="120">गोलाकार आकार</th>
                                                <th width="120">लम्बाइ</th>
                                                <th width="120">चौड़ाई</th>
                                                <th width="150">मात्रा</th>
                                                <th width="150">दर</th>
                                                <th width="120">ठहर परिणाम</th>
                                                <th width="150">रकम</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tr style="line-height:5px" id="item-1" data-rowid="1">
                                            <td><span id="sr_no"></span></td>
                                            <td width="350">
                                                @Html.DropDownList("wood_type_id", (SelectList)ViewBag.woodType, new { @class = "form-control chosen wood_type_id", @id = "wood_type_id" })
                                            </td>
                                            <td width="160">
                                                <input type="number" class="circle_size form-control input-sm text-left" id="circle_size" data-srno="1" />
                                            </td>
                                            <td width="160">
                                                <input type="number" class="length form-control input-sm text-left" id="length" data-srno="1" />
                                            </td>
                                            <td width="160">
                                                <input type="number" class="breadth form-control input-sm text-left" id="breadth" data-srno="1" />
                                            </td>
                                            <td width="160">
                                                <input type="number" class="quantity form-control input-sm text-left" id="quantity" data-srno="1" />
                                            </td>
                                            <td width="160">
                                                <input type="number" class="rate form-control input-sm text-left" id="rate" data-srno="1" />
                                            </td>
                                            <td width="160">
                                                <input type="text" class=" net_total_size form-control input-sm text-left" readonly name="net_total_size" id="net_total_size" data-srno="1" />
                                            </td>
                                            <td width="190"> <input type="number" class="amount form-control input-sm text-left" readonly name="amount" id="amount" data-srno="1" /></td>
                                            <td><button type="button" name="add-item" id="add-item" class="form-control btn btn-success btn-md add-item-row"><span class="fa fa-plus "></span></button></td>
                                        </tr>
                                    </table>
                                    <table class="table table-striped items-bag"></table>
                                </div>
                            </div>
                            <br />
                            <div class="row" style="margin-top:-20px">
                                <div class="col-md-12">
                                    <div class="form-group row">
                                        <div class="col-md-8">
                                            टिप्पणीहरू <textArea rows="5" id="remarks" name="remarks" class="w-100"></textArea>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    कुल ठहर परिणाम
                                                </div>
                                                <div class="col-md-8">
                                                    <input value="0" style="background-color:darkseagreen" readonly type="number" id="total_wood_size" class="form-control input-sm total_wood_size" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    जम्मा
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" readonly id="final_total_amt" class="form-control input-sm" name="final_total_amt" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    न.पा.कर %
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" id="tax_percentage" class="form-control input-sm" name="tax_percentage" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    न.पा.कर
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" readonly id="tax_amount" class="form-control input-sm" name="tax_amount" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    कुल जम्मा
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" readonly id="net_final_total_amt" class="form-control input-sm" name="net_final_total_amt" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    निविदा रकम
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" value="0" id="paid_amt" class="form-control input-sm" name="paid_amt" />
                                                </div>
                                            </div>
                                            <div class="form-group row">
                                                <div class="col-md-4">
                                                    फिर्ती रकम
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="number" value="0" readonly id="return_amt" class="form-control input-sm return_amt" name="return_amt" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <button type="submit" formtarget="_blank" id="save" name="save" class="btn btn-primary waves-effect w-md waves-light pull-right">
                                <i class="fa fa-calculator"></i>
                                बिल
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        $(document).ready(function () {
              $('#memberSelect').change(function () {
                var MemberId = $(this).val();
                $.ajax({
                    url: '/billing/member-punishment/check-member-validity/' + MemberId,
                            type: 'GET',
                    success: function(response) {
                        if (!response) {
                            $('#membershipStatusMessage').html('<div class="alert alert-danger">This member has an active punishment!</div>');
                        }
                        else{
                            $('#membershipStatusMessage').html('');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#membershipStatusMessage').html('<div class="alert alert-warning">An error occurred: ' + error + '</div>');
                    }
                });
             });

            var count = 1;
            $('.member').select2();
            $('.chosen').select2();

            $(".member-row").hide();
            $(".customer-row").hide();

            $(".sales_type").change(function () {
                $('#loading').show();
                var salesTypeId = $(".sales_type").val();
                if (salesTypeId == @((int)LE.Billing.Common.Enums.SalesType.Member)) {
                    $(".member-row").show();
                    $(".customer-row").hide();
                    $("#other_customer").val("");
                }
                else if (salesTypeId == @((int)LE.Billing.Common.Enums.SalesType.Others) || salesTypeId == @((int)LE.Billing.Common.Enums.SalesType.Anudhan) ) {
                    $(".customer-row").show();
                    $(".member-row").hide();
                    $('.member').val(null).trigger('change');
                }
                else {
                    $(".member-row").hide();
                    $(".customer-row").hide();
                    $('.member').val(null).trigger('change');
                }
                $('#loading').hide();
            });
            $(".sales_type").change();
            $woodTypes = [];

            $.ajax({
                method: 'Get',
                url: '/billing/api/wood-type',
                success: function (data) {
                    $woodTypes = data;
                },
                error: function () {
                    alert("Error in loading wood types.");
                }
            })

            var wood_type_name = "";
            var i;
            function getWoodTypeById($id) {
                for (i = 0; i < $woodTypes.length; i++) {

                    if ($woodTypes[i].wood_type_id == $id) {
                        wood_type_name = $woodTypes[i].name;
                    }
                }
                return wood_type_name;
            }

            $(document).on("keyup change keydown", ".rate ,.circle_size, .length, .breadth, .quantity", function () {
                calculateRowValues();
            });

            function calcTotalWoodSize(){
                let totWoodSize = 0;
                $(".items-bag tr").each(function (i, row) {
                    var $row = $(row);
                    totWoodSize = totWoodSize + parseFloat($row.find('.woodSize').html());
                });
                $("#total_wood_size").val(totWoodSize);
            }

            function calculateRowValues() {
                $circleSize = parseFloat($("#circle_size").val());
                $length = parseFloat($("#length").val());
                $breadth = parseFloat($("#breadth").val());
                $quantity = parseFloat($("#quantity").val());
                $rate = parseFloat($("#rate").val());

                if ($circleSize > 0 && $length > 0 && $breadth > 0 && $quantity > 0 || $rate > 0) {
                    $totalSize = (($circleSize * $length * $breadth * $quantity) / 144);

                    $totalAmt = $totalSize * $rate;

                    $("#net_total_size").val(parseFloat($totalSize).toFixed(2));
                    $("#amount").val(parseFloat($totalAmt).toFixed(2));
                }
                else {
                    $("#net_total_size").val(0);
                    $("#amount").val(0);
                }
            }

            $(document).on("keypress", "form", function (event) {
                return event.keyCode != 13;
            });

            $(document).on('keypress mousedown', '.add-item-row', function (e) {
                var type = $(".wood_type_id").val();
                var typeName = getWoodTypeById(type);
                var circle_size = $(".circle_size").val();
                var length = $(".length").val();
                var breadth = $(".breadth").val();
                var quantity = $(".quantity").val();
                var rate = $(".rate").val();
                var netTotalSize = $(".net_total_size").val();
                var amount = $(".amount").val();

                if (rate <= 0 || rate == "" || type <= 0 || circle_size <= 0 || circle_size == "" || length <= 0 || length == "" || breadth <= 0 || breadth == "" || quantity <= 0 || quantity == "") {
                    showMessage("Fields cannot be empty or negative");
                    e.preventDefault();
                }

                else {
                    var tableRow = '<tr><td id="sno" width="30">#</td><td width="490">' + typeName + '<input type="hidden" name="hdnObjectId" class="form-control" readonly value="' + type + '"/></td><td width="130">' + circle_size + '</td><td width="160">' + length + '</td><td width="160">' + breadth + '</td><td width="160">' + quantity + '</td><td width="160">' + rate + '</td><td width="160" class="woodSize">' + netTotalSize + '</td><td width="160">' + amount + '<input type="hidden" name="hdnAmount" class="form-control" readonly value="' + amount + '"/></td><td><button class="btn btn-sm btn-danger delete-row"><i class="fa fa-trash"><i></button></td>';

                    $(".items-bag").append(tableRow);
                    var amtTot = getTotalAmount();

                    var num_word = num2str(amtTot);
                    $("#num_to_words").val(num_word);
                    calcTotalWoodSize();
                    clearRow();
                }
            });

            $(document).on("keyup keydown", "#paid_amt", function (e) {
                var totAmt = parseFloat($("#net_final_total_amt").val());
                var tenderAmt = parseFloat($("#paid_amt").val());
                if (tenderAmt > totAmt) {
                    var diff = tenderAmt - totAmt;
                    $("#return_amt").val(diff.toFixed(2));
                } else {
                    $("#return_amt").val(0);
                }
            });

            $(document).on("keyup keydown", "#tax_percentage", function () {
                getTotalAmount();
            });

            $(document).on("click", ".delete-row", function (e) {
                if (confirm("Are you sure to remove the item?")) {
                    $(this).closest("tr").remove();
                    $("#final_total_amt").val(getTotalAmount());
                    showMessage("Wood Removed from list.");
                }
                e.preventDefault();
            });


            function getTotalAmount() {
                var netFinalAmt = 0;
                $(".items-bag tr").each(function (i, row) {
                    var $row = $(row);
                    netFinalAmt = netFinalAmt + parseFloat($row.find('input[name*="hdnAmount"]').val());
                });
                $("#final_total_amt").val(netFinalAmt.toFixed(2));

                var taxAmt = 0;
                var taxPer = parseFloat($("#tax_percentage").val());
                if (taxPer > 0) {
                    taxAmt = parseFloat((taxPer * netFinalAmt) / 100);
                }
                $("#tax_amount").val(taxAmt.toFixed(2));

                $("#net_final_total_amt").val(parseFloat(netFinalAmt + taxAmt).toFixed(2));

                return netFinalAmt.toFixed(2);
            }

            function clearRow() {
                $(".rate").val(0);
                $(".amount").val(0);
                $(".circle_size").val(0);
                $(".length").val(0);
                $(".breadth").val(0);
                $(".quantity").val(0);
            }

            $(document).on("click", "#save", function (e) {
                e.preventDefault();

                $tenderAmt = parseFloat($("#paid_amt").val());
                $totAmt = parseFloat($("#net_final_total_amt").val());

                var saleTypeId = $(".sales_type").val();
                if (saleTypeId == @((int)LE.Billing.Common.Enums.SalesType.Member)) {
                    $memVal = $("#memberSelect").val();
                    if ($memVal == "" || $memVal == null || $memVal <= 0) {
                        showMessage("Member Not Selected.");
                        return false;
                    }
                }

                if (saleTypeId == @((int)LE.Billing.Common.Enums.SalesType.Anudhan) || saleTypeId == @((int)LE.Billing.Common.Enums.SalesType.Others)) {
                    $otherCustomerVal = $("#other_customer").val();
                    if ($otherCustomerVal == "") {
                        showMessage("Customer is Required.");
                        return false;
                    }
                }

                if ($tenderAmt < 0 || $totAmt < 0 || $totAmt > $tenderAmt) {
                    showMessage("Invalid Paid amount or Paid Amount is less than billed amount.");
                    return false;
                }

                else {
                    $('#loading').show();
                    var items = {};
                    items.nep_sales_date = $("#nep_sales_date").val();
                    items.sales_type = parseInt($("#sales_type").val(), 10);
                    var selectedMemberId = $("#memberSelect").val();
                    items.MemberId = (selectedMemberId === "" || selectedMemberId == null) ? null : parseInt(selectedMemberId, 10);
                    items.other_customer = $("#other_customer").val();
                    items.total_amount = parseFloat($("#final_total_amt").val());
                    items.tender_amount = parseFloat($("#paid_amt").val());
                    items.return_amount = parseFloat($("#return_amt").val());
                    items.remarks = $("#remarks").val();
                    items.tax_percentage = parseFloat($("#tax_percentage").val());
                    var item = [];
                    $(".items-bag tr").each(function (i, row) {
                        var data = {};
                        var $row = $(row);
                        data.wood_type_id = parseInt($row.find('input[name*="hdnObjectId"]').val());
                        data.circle_size = parseFloat($row.find("td").eq(2).text());
                        data.length = parseFloat($row.find("td").eq(3).text());
                        data.breadth = parseFloat($row.find("td").eq(4).text());
                        data.quantity = parseFloat($row.find("td").eq(5).text());
                        data.rate = parseFloat($row.find("td").eq(6).text());
                        item.push(data);
                    });
                    items["chiranItems"] = item;

                    if (item.length > 0) {
                        $.ajax({
                            contentType: 'application/json; charset=utf-8',
                            type: "POST",
                            beforeSend: function (xhr) {
                                xhr.setRequestHeader("XSRF-TOKEN",
                                    $('input:hidden[name="__RequestVerificationToken"]').val());
                            },
                            url: "/billing/chiran-billing/new",
                            dataType: "json",
                            data: JSON.stringify(items),
                            success: function (response) {
                                if (response == null) {
                                    alert("Something went wrong");
                                }
                                else if (response.error == true) {
                                    showMessage(response.responseText);
                                }
                                else {
                                    window.focus();

                                    window.open(
                                        '/billing/chiran-billing/bill?chiran_sales_id=' + response,
                                        '_blank'
                                    );
                                    window.setTimeout(function () {
                                        window.location.reload();
                                    }, 200);
                                }
                                $('#loading').hide();
                            },
                            error: function (response) {
                                showMessage(response.responseText)
                                $('#loading').hide();
                            }
                        });
                    }
                    else {
                        showMessage("Items Note Selected.");
                        e.preventDefault();
                        $('#loading').hide();

                    }
                }
            });

            function showMessage($message) {
                $.toast({
                    heading: 'Message!',
                    text: $message,
                    position: 'top-right',
                    loaderBg: '#45bbe0',
                    icon: 'info',
                    hideAfter: 3000,
                    stack: 1
                });
            }
            $('#loading').hide();
        });
    </script>
}
