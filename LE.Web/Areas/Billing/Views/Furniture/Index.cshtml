@model FurnitureIndexViewModel
@{
    ViewData["Title"] = Localizer["Furniture"];


    var list = new List<SelectListItem>() {
new SelectListItem { Text = "10", Value = "10"},
new SelectListItem { Text = "20", Value = "20" },
new SelectListItem { Text = "30", Value = "30" },
new SelectListItem { Text = "40", Value = "40"},
new SelectListItem { Text = "50", Value = "50" }
};
}

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Furniture"]</b></h4>
                <div class="row">
                    <div class="col-sm-6">
                        <a href="/billing/furniture/new" class="btn btn-icon waves-effect waves-light btn-success btn-sm"><i class="fa fa-plus"></i> @Localizer["Add New Furniture"]</a>
                    </div>
                    <form action="/billing/furniture" method="get" class="row col-sm-6">

                        <div class="col-sm-6">
                            @Html.TextBox("name", (string)ViewBag.name, new { @class = "form-control", placeholder = "Furniture Name" })
                        </div>
                        <div class="col-sm-3">
                            @Html.DropDownList("number_of_rows", list, new { @class = "form-control" })
                        </div>
                        <div class="col-sm-3">
                            <button type="submit" class="form-control no-padding btn btn-primary btn-lg"><i class="fa fa-refresh"></i></button>
                        </div>

                    </form>
                </div>
                <br />
                <div class="table-responsive">
                    <table class="table m-0 table-colored-bordered table-bordered-custom">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>@Localizer["S.N"]</th>
                                <th>@Localizer["Furniture"]</th>
                                <th>@Localizer["Furniture Category"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                foreach (var furniture in Model.furnitures)
                                {
                                    string status = "Enabled";
                                    string statusColor = "success";
                                    if (furniture.is_enabled == false)
                                    {
                                        status = "Disabled";
                                        statusColor = "danger";
                                    }
                                    <tr>

                                        <td>@sn</td>
                                        <td>@furniture.name</td>
                                        <td>@(furniture.furniture_category?.name ?? "N/A")</td>
                                        <td><span class="badge badge-@statusColor">@status</span></td>
                                        <td>

                                            <a href="/billing/furniture/edit/@furniture.furniture_id" class="btn btn-icon waves-effect waves-light btn-primary btn-sm" title="Edit"><i class="fa fa-pencil"></i></a>
                                            <a href="/billing/furniture/delete/@furniture.furniture_id" class="btn btn-icon waves-effect waves-light btn-danger btn-sm delete" title="Delete"><i class="fa fa-trash"></i></a>
                                            @{
                                                string actionName = furniture.is_enabled ? "Disable" : "Enable";
                                                string icon = furniture.is_enabled ? "fa-thumbs-down" : "fa-thumbs-up";
                                                string color = furniture.is_enabled ? "btn-danger" : "btn-success";
                                            }

                                            <a href="/billing/furniture/@actionName/@furniture.furniture_id" class="btn btn-icon waves-effect waves-light btn-sm @color" data-toggle="tooltip" title="@actionName furniture"><i class="fa @icon"></i></a>

                                        </td>

                                    </tr>
                                    sn++;
                                }
                            }
                        </tbody>
                    </table>
                    <br />
                    <LeadingEdgePager info="@ViewBag.pagerInfo" route="billing_furniture_index"></LeadingEdgePager>
                </div>
            </div>
        </div>
    </div>
</div>