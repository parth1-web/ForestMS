@model ToleDto
@{
    ViewData["Title"] = Localizer["Update Tole"];
}


<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Update Tole"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Updates a Tole"]
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post" action="/billing/tole/edit">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(a=>a.tole_id)
                            @Html.AntiForgeryToken()


                            <div class="form-group row">
                                @Html.LabelFor(a => a.tole_no, new { @class = "col-md-3 control-label asterik" })

                                <div class="col-md-9">
                                    @Html.TextBoxFor(a => a.tole_no, new { @class = "form-control name" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.tole_no)</p>
                            </div>


                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12">
                        <p>@Localizer["Note"]: <span class="asterik"></span> @Localizer["Fields are mandatory"]</p>
                    </div>
                </div>
                <!-- end row -->
            </div>
        </div>
    </div><!-- end col -->
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
    </script>
}
