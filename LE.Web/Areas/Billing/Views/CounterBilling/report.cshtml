@model CounterBillIndexViewModel;
@{
    ViewData["Title"] = Localizer["Counter Bill Report"];
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Counter Bill Report"]</b></h4>
                <div class="row">
                    <form method="get" class="col-md-11 form-inline">
                        @Html.LabelFor(a => a.start_date, new { @class = "control-label", style = "margin-right:3px;" })
                        @Html.TextBoxFor(a => a.start_date, new { @class = "form-control no-padding nepali-calendar", id = "start_date" })

                        @Html.LabelFor(a => a.end_date, new { @class = "control-label", style = "margin-right:5px; margin-left:5px;" })
                        @Html.TextBoxFor(a => a.end_date, new { @class = "form-control nepali-calendar", id = "end_date" })

                        <div class="col-md-3">
                            @Html.DropDownListFor(a=>a.user_id, (SelectList)ViewBag.users, "--Select User--", new { @class = "form-control chosen" })
                        </div>

                        <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right" style="margin-left:5px;"> @Localizer["Load"] <i class="fa fa-spinner "></i></button>

                        <div class="pull-right">
                            <button type="submit" formtarget="_blank" formaction="/billing/counter/report-print" class="btn btn-success waves-effect w-md waves-light pull-right" style="margin-left:5px;"> <i class="fa fa-print "></i></button>
                        </div>
                    </form>

                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>@Localizer["S.N"]</th>
                                <th>@Localizer["Sales Date"]</th>
                                <th>@Localizer["Discount"]</th>
                                <th>@Localizer["Tax"]</th>
                                <th>@Localizer["Amount"]</th>
                                <th>@Localizer["Remarks"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 1;
                                decimal totalAmount = 0;
                                decimal discountTotal = 0;
                                decimal taxTotal = 0;
                                foreach (var detail in Model.counter_bill_details)
                                {

                                    <tr>
                                        <td>@sn</td>
                                        <td>@detail.nep_sales_date</td>


                                        <td>@detail.discount_amount</td>
                                        <td>@detail.tax_amount</td>
                                        <td>@detail.bill_amount</td>
                                        <td>@detail.remarks</td>
                                       
                                    </tr>
                                    totalAmount += detail.bill_amount;
                                    discountTotal += detail.discount_amount;
                                    taxTotal += detail.tax_amount;
                                    sn++;

                                }
                            }
                            <tr>
                                <td colspan="1"></td>
                                <td>@Localizer["Total Amount"]</td>
                                <td>@discountTotal</td>
                                <td>@taxTotal</td>
                                <td>@totalAmount</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            $('.chosen').select2();
    });
    </script>
}