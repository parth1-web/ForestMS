@model ServiceModel
@{
    ViewData["Title"] = Localizer["Update Service"];
}

<div class="row">
    <div class="col-sm-12">

        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Update Service"]</b></h4>
                <p class="text-muted m-b-30">
                    @Localizer["Updates a Service."]
                </p>
                <div class="row">
                    <div class="col-lg-6">
                        <form class="form-horizontal" method="post" action="/billing/service/edit">
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(a => a.service_id)
                            @Html.AntiForgeryToken()


                            <div class="form-group row">
                                @Html.LabelFor(a => a.name, new { @class = "col-md-4 control-label asterik" })

                                <div class="col-md-8">
                                    @Html.TextBoxFor(a => a.name, new { @class = "form-control name" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.name)</p>
                            </div>

                            <div class=" form-group row">
                                @Html.LabelFor(a => a.category_id, new { @class = "col-md-4 control-label asterik" })
                                <div class="col-md-8">
                                    @Html.DropDownList("category_id", (SelectList)ViewBag.serviceCategories, new { @class = "form-control" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.category_id)</p>

                            </div>
                            <div class=" form-group row">
                                @Html.LabelFor(a => a.ledger_id, new { @class = "col-md-4 control-label asterik" })
                                <div class="col-md-8">
                                    @Html.DropDownList("ledger_id", (SelectList)ViewBag.ledgers, new { @class = "form-control" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.ledger_id)</p>

                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.rate, new { @class = "col-md-4 control-label asterik" })

                                <div class="col-md-8">
                                    @Html.TextBoxFor(a => a.rate, new { @class = "form-control ", type = "number" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.rate)</p>
                            </div>

                            <div class="form-group row">
                                @Html.LabelFor(a => a.tax, new { @class = "col-md-4 control-label" })

                                <div class="col-md-8">
                                    @Html.TextBoxFor(a => a.tax, new { @class = "form-control ", type = "number" })

                                </div>
                                <p class="text-danger">@Html.ValidationMessageFor(a => a.tax)</p>
                            </div>


                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary waves-effect w-md waves-light pull-right"><i class="fa fa-save fa-lg"> @Localizer["Save"]</i></button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-12">
                        <p>@Localizer["Note"]:<br /> <span class=""></span> @Localizer["Rate must be included with tax."]<br /><span class="asterik"></span> @Localizer["Fields are mandatory"].</p>
                    </div>
                </div>
                <!-- end row -->
            </div>
        </div>
    </div><!-- end col -->
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $(".name").focus();
        });
    </script>
}
