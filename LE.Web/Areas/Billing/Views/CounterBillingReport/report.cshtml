@model CounterBillIndexViewModel;
@{
    ViewData["Title"] = Localizer["Counter Bill Report"];
    var list = new List<SelectListItem>() {
        new SelectListItem { Text = "Billed", Value = "false"},
        new SelectListItem { Text = "Cancelled", Value = "true" }
    };
}
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="m-t-0 header-title"><b>@Localizer["Counter Bill Report"]</b></h4>
                <div class="row">
                    <form method="get" class="col-md-12 form-inline mb-2">
                        <div class="col-md-3 d-flex">
                            @Html.LabelFor(a => a.start_date, new { @class = "control-label mr-2" })
                            @Html.TextBoxFor(a => a.start_date, new { @class = "form-control nepali-calendar", id = "start_date" })
                        </div>

                        <div class="col-md-3 d-flex">
                            @Html.LabelFor(a => a.end_date, new { @class = "control-label mr-2"})
                            @Html.TextBoxFor(a => a.end_date, new { @class = "form-control nepali-calendar", id = "end_date" })
                        </div>

                        @Html.DropDownListFor(a=>a.is_cancelled, list, new {@class = "form-control col-md-1"})

                        <div class="col-md-2">
                            @Html.DropDownListFor(a => a.user_id, (SelectList)ViewBag.users, "--Select User--", new { @class = "form-control chosen" })
                        </div>

                        <button type="submit" class="btn btn-primary waves-effect w-md waves-light col-md-1">@Localizer["Load"] <i class="fa fa-spinner "></i></button>

                        <div class="col-md-1">
                            <button type="submit" formtarget="_blank" formaction="/billing/counter/report-print" class="btn btn-success waves-effect w-md waves-light"> <i class="fa fa-print "></i></button>
                        </div>

                    </form>

                </div>
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead class="bg-custom text-white">
                            <tr>
                                <th>@Localizer["S.N"]</th>
                                <th>@Localizer["Sales Date"]</th>
                                <th>@Localizer["Counter"]</th>
                                @*<th>@Localizer["Discount"]</th>*@
                                @*<th>@Localizer["Tax"]</th>*@
                                <th>@Localizer["Amount"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Remarks"]</th>
                                <th>@Localizer["Action"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var sn = 1;
                                decimal totalAmount = 0;
                                decimal discountTotal = 0;
                                decimal taxTotal = 0;
                                foreach (var detail in Model.counter_bill_details)
                                {
                                    string status = "Billed";
                                    if (detail.is_cancelled)
                                    {
                                        status = "Cancelled";
                                    }
                                    <tr>
                                        <td>@sn</td>
                                        <td>
                                            @detail.nep_sales_date (@detail.sales_date.ToLongTimeString())
                                        </td>
                                        <td>@detail.user.full_name</td>
                                        @*<td>@detail.discount_amount</td>*@
                                        @*<td>@detail.tax_amount</td>*@
                                        <td>@detail.bill_amount</td>
                                        <td>
                                            <label class="badge badge-info font-14">@status</label>
                                        </td>
                                        <td>@detail.remarks</td>
                                        <td>

                                            @{
                                                var modalId = "#modal" + detail.sales_id;
                                                var modal = "modal" + detail.sales_id;
                                            }
                                            <button type="button" class="btn btn-info btn-md" data-toggle="modal" data-target="@modalId">Details</button>

                                            <!-- Modal -->
                                            <div id="@modal" class="modal fade" role="dialog">
                                                <div class="modal-dialog">

                                                    <!-- Modal content-->
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Bill Details (Bill No : @detail.sales_id)</h5>
                                                        </div>
                                                        <div class="modal-body">
                                                            <table class="table table-bordered table-bordered-info">
                                                                <thead>
                                                                    <tr>
                                                                        <td>S.N</td>
                                                                        <td>Service</td>
                                                                        <td>Qty</td>
                                                                        <td>Rate</td>
                                                                        <td>Amount</td>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @{
                                                                        var serialno = 1;
                                                                        decimal totalTableAmount = 0;
                                                                        foreach (var data in detail.counter_sales_details)
                                                                        {
                                                                            var rowTotal = Math.Round((data.rate * data.qty), 2);

                                                                            <tr>
                                                                                <td>@serialno</td>
                                                                                <td>@data.service.name</td>
                                                                                <td>@data.qty</td>
                                                                                <td>@data.rate</td>
                                                                                <td>@rowTotal</td>
                                                                            </tr>
                                                                            totalTableAmount += rowTotal;
                                                                            serialno++;
                                                                        }
                                                                    }
                                                                    <tr>
                                                                        <td colspan="4"> Tax Amount</td>
                                                                        <td>@detail.tax_amount</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td colspan="4"> Total</td>
                                                                        <td> @(totalTableAmount + detail.tax_amount)</td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>


                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                            <a href="/billing/counter/cancel/@detail.sales_id"
                                           class="btn btn-danger post-link" data-confirm="Are you sure to cancel bill?">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </td>

                                    </tr>
                                    totalAmount += detail.bill_amount;
                                    discountTotal += detail.discount_amount;
                                    taxTotal += detail.tax_amount;
                                    sn++;

                                }
                            }
                            <tr>
                                <td colspan="1"></td>
                                <td>@Localizer["Total Amount"]</td>
                                <td></td>
                                <td>@taxTotal</td>
                                <td>@totalAmount</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function() {
            $('.chosen').select2();

        });
    </script>
}